<?xml version="1.0" encoding="UTF-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/source/MainScene.brs" />
    <children>
        <Poster
            id="poster"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFit"
        />
        <Label
            id="status"
            translation="[60, 40]"
            width="1800"
            height="60"
            color="0xffffffff"
            font="font:MediumSystemFont"
            text="Loading Dashboard Streams..."
        />
        <Timer id="refreshTimer" duration="1.0" repeat="true" />
    </children>
</component>
